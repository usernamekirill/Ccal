# Скопируйте в .env и замените секреты. В Git не коммитьте.

BOT_TOKEN=
OPENAI_API_KEY=

DATABASE_TYPE=postgres
DATABASE_URL=postgresql+asyncpg://calorie_user:strong_password@postgres:5432/calorie_bot

POSTGRES_DB=calorie_bot
POSTGRES_USER=calorie_user
POSTGRES_PASSWORD=strong_password

LOG_LEVEL=INFO

# Опционально: то же, что BOT_TOKEN (если заданы оба, приоритет у TELEGRAM_BOT_TOKEN)
# TELEGRAM_BOT_TOKEN=

APP_ENV=production
TIMEZONE=Europe/Moscow
TEMP_MEDIA_DIR=/app/tmp
POSTGRES_POOL_SIZE=5
POSTGRES_MAX_OVERFLOW=10
HEALTH_CHECK_HOST=127.0.0.1
HEALTH_CHECK_PORT=0

# Локальная разработка (SQLite):
# DATABASE_TYPE=sqlite
# DATABASE_URL=sqlite+aiosqlite:///./data/calorie_bot.db
#
# Бэкапы Postgres (по умолчанию ./backups на хосте; в compose том backups → /app/backups):
# BACKUP_DIR=./backups
